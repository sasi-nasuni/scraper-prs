# LLM Configuration
# Option 1: Use GitHub Models (recommended if you have GitHub API key)
# OPENAI_API_KEY=your-github-token
# OPENAI_API_BASE=https://models.inference.ai.azure.com

# Option 2: Use OpenAI directly
# OPENAI_API_KEY=sk-...

# Option 3: Use Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# LLM Model Selection
LLM_PROVIDER=openai  # or anthropic
LLM_MODEL=gpt-4o  # GitHub Models: gpt-4o, gpt-4o-mini, claude-3-5-sonnet, llama-3.1-70b, etc.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# GitHub Configuration
# For GitHub Models, use the same token as OPENAI_API_KEY above
GITHUB_TOKEN=your-github-token
GITHUB_API_URL=https://api.github.com

# Atlassian Configuration (Jira, Confluence)
# Third-party MCP server: @joshuajaco/mcp-server-atlassian
# Uses API token authentication - fully automated, no browser required
# Create API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=...

# Confluence (uses same credentials as above)
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_EMAIL=your.email@example.com
CONFLUENCE_API_TOKEN=...

# Figma Configuration
FIGMA_API_TOKEN=...

# MCP Server Configuration
MCP_TIMEOUT=30  # seconds
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=2  # seconds

# Agent Configuration
MAX_PRS_TO_PROCESS=5
ENABLE_PARALLEL_PROCESSING=true
GENERATE_FALLBACK_SUMMARIES=true

# Output Configuration
OUTPUT_DIR=outputs
TEMPLATE_DIR=templates

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=scraper-prs.log
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true

# LangSmith (Optional - for tracing and debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
# LANGCHAIN_PROJECT=scraper-prs
